# Week 8 — copy to .env in work dir (never commit)

OPENAI_API_KEY=sk-...
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# GitHub (MCP + ingestion)
GITHUB_TOKEN=ghp_...

# Web search MCP (pick one)
TAVILY_API_KEY=tvly-...
# BRAVE_SEARCH_API_KEY=...

# PostgreSQL + pgvector (Docker Compose default)
DATABASE_URL=postgresql+asyncpg://radar:radar@localhost:5432/ai_radar

# Redis semantic cache (Day 5+)
REDIS_URL=redis://localhost:6379/0
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.92

# Email digest (Day 6+) — Resend or SMTP
RESEND_API_KEY=re_...
DIGEST_FROM_EMAIL=radar@yourdomain.com
DIGEST_TO_EMAIL=you@example.com
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=

# Scheduler
INGESTION_CRON=0 */6 * * *
DIGEST_CRON=0 7 * * *

# Cost guardrails
MAX_COST_USD_PER_REQUEST=0.25
DAILY_BUDGET_USD=10.00

# Eval CI thresholds
RAGAS_FAITHFULNESS_MIN=0.75
RAGAS_CONTEXT_PRECISION_MIN=0.70
EVAL_REGRESSION_MAX_PCT=5

# Optional Azure
# AZURE_CONTAINER_REGISTRY=
# AZURE_RESOURCE_GROUP=

LOG_LEVEL=INFO
