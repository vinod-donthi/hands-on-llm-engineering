# Week 3 — copy to .env in work dir (never commit)

OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Embeddings (OpenAI default; or Ollama for local)
EMBEDDING_MODEL=text-embedding-3-small
OLLAMA_BASE_URL=http://localhost:11434

# Chat model for generation
CHAT_MODEL=gpt-4o-mini

# Chroma (local dev)
CHROMA_PERSIST_DIR=./data/chroma

# PostgreSQL + pgvector (production path, Day 6+)
DATABASE_URL=postgresql+asyncpg://docqa:docqa@localhost:5432/doc_qa_studio

# Optional reranking (Cohere API — Lab 4 can use local cross-encoder instead)
COHERE_API_KEY=

# Cost guardrails
MAX_COST_USD_PER_REQUEST=0.10
DAILY_BUDGET_USD=8.00

# Optional
LOG_LEVEL=INFO
