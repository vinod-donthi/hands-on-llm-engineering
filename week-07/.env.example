# Week 7 — copy to .env in work dir (never commit)

OPENAI_API_KEY=sk-...

# Fine-tuning (Track A)
OPENAI_FINE_TUNE_BASE_MODEL=gpt-4o-mini-2024-07-18
# After job completes:
# OPENAI_FINE_TUNED_MODEL=ft:gpt-4o-mini-2024-07-18:org:advanced-studio:abc123

# Azure OpenAI (optional alternative fine-tune path)
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Anthropic (optional teacher/judge)
# ANTHROPIC_API_KEY=sk-ant-...

# Embeddings + RAG (Track B)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=advanced_studio_docs

# Redis / cache (Week 5 carry-over)
REDIS_URL=redis://localhost:6379/0

# Langfuse (optional — trace agentic RAG)
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com

# MCP production server (Lab 6)
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8080
MCP_API_KEY=change-me-in-production
MCP_RATE_LIMIT_RPM=60

# Ollama (distillation / small model lab)
OLLAMA_HOST=http://localhost:11434
OLLAMA_SMALL_MODEL=llama3.2:3b

# Cost guardrails
MAX_COST_USD_PER_REQUEST=0.25
DAILY_BUDGET_USD=25.00

# Capstone track: A (finetune) or B (agentic_rag)
ADVANCED_STUDIO_TRACK=B

LOG_LEVEL=INFO
ENVIRONMENT=development
