# Week 5 — copy to .env in work dir (never commit)

OPENAI_API_KEY=sk-...

# Redis (Docker Compose default)
REDIS_URL=redis://localhost:6379/0

# Langfuse (Day 6+) — https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# OpenTelemetry (optional local collector)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
OTEL_SERVICE_NAME=production-ai-stack

# Rate limits
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=10

# Semantic cache
SEMANTIC_CACHE_THRESHOLD=0.92
SEMANTIC_CACHE_TTL_SECONDS=3600

# Cost guardrails
MAX_COST_USD_PER_REQUEST=0.10
DAILY_BUDGET_USD=10.00

# Qdrant (optional — Week 3 carry-over)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=docs

# Azure Container Apps (optional Day 7)
# AZURE_SUBSCRIPTION_ID=
# AZURE_RESOURCE_GROUP=rg-production-ai-stack
# AZURE_CONTAINER_APP_NAME=production-ai-stack

LOG_LEVEL=INFO
ENVIRONMENT=development
