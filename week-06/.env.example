# Week 6 — copy to .env in work dir (never commit)

OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Judge + eval models
EVAL_JUDGE_MODEL=gpt-4o-mini
CHAT_MODEL=gpt-4o-mini

# Langfuse (primary observability for Week 6)
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# Optional: LangSmith instead of Langfuse (Lab 6)
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=lsv2_...
# LANGCHAIN_PROJECT=eval-pipeline-studio

# OpenTelemetry (export to Langfuse OTLP endpoint)
OTEL_SERVICE_NAME=eval-pipeline-studio
OTEL_EXPORTER_OTLP_ENDPOINT=https://cloud.langfuse.com/api/public/otel

# Eval thresholds (CI gate)
EVAL_FAITHFULNESS_BASELINE=0.78
EVAL_FAITHFULNESS_MIN=0.73
EVAL_REGRESSION_MAX_PCT=5.0
GOLDEN_DATASET_MIN_SAMPLES=30

# Cost guardrails
MAX_COST_USD_PER_EVAL_RUN=5.00
DAILY_BUDGET_USD=15.00

# GitHub Actions (local dry-run with act — optional)
GITHUB_TOKEN=

# Optional
LOG_LEVEL=INFO
