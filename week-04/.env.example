# Week 4 — copy to .env in work dir (never commit)

OPENAI_API_KEY=sk-...

# Web search (pick one — Tavily recommended for labs)
TAVILY_API_KEY=tvly-...
# DuckDuckGo needs no key (rate-limited fallback)

# Optional — reuse Week 3 vector store path
CHROMA_PERSIST_DIR=./data/chroma

# LangGraph checkpoint store (SQLite default for dev)
CHECKPOINT_DB_PATH=./data/checkpoints.sqlite

# HITL — webhook or local approval UI
HITL_APPROVAL_TIMEOUT_SEC=300
HITL_REQUIRE_APPROVAL_FOR=web_search,send_email,delete_file

# Cost guardrails
MAX_COST_USD_PER_RUN=0.50
DAILY_BUDGET_USD=10.00
MAX_TOOL_ROUNDS=12

# MCP server (Lab 3+)
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8765

# Optional
LOG_LEVEL=INFO
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=research-agent-studio
